---
import { Image } from "astro:assets";
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import PostList from "../../components/PostList.astro";
import { getPosts, getProjects, type Project } from "../../lib/content";
import { breadcrumbs, person, project as projectSchema } from "../../data/schema";

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((p, i) => ({
    params: { slug: p.id },
    props: { project: p, next: projects[(i + 1) % projects.length] },
  }));
}

interface Props {
  project: Project;
  next: Project;
}
const { project, next } = Astro.props;
const { data } = project;
const { Content } = await render(project);
const path = `/work/${project.id}/`;
const og = `/og/work/${project.id}.png`;
const related = (await getPosts("en")).filter((p) => p.data.project === project.id);
const repoName = data.repo.replace("https://github.com/", "");
---

<Base
  title={`${data.title} - Kacper Pawlowski`}
  description={data.description}
  image={og}
  imageAlt={data.coverAlt}
  jsonLd={[
    person(),
    projectSchema({ title: data.title, description: data.description, path, repo: data.repo, image: og, tags: data.tags }),
    breadcrumbs([
      { name: "Home", path: "/" },
      { name: "Work", path: "/work/" },
      { name: data.title, path },
    ]),
  ]}
>
  <article>
    <header class="wrap head">
      <nav class="crumbs mono" aria-label="Breadcrumb">
        <a href="/">Home</a><span aria-hidden="true">/</span><a href="/work/">Work</a><span aria-hidden="true">/</span
        ><span aria-current="page">{data.title}</span>
      </nav>
      <p class="eyebrow">{data.area}</p>
      <h1>{data.title}</h1>
      <p class="lede">{data.summary}</p>
      <div class="meta">
        <a class="btn btn--ghost" href={data.repo} rel="noopener" target="_blank">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
            ><path
              d="M12 .5C5.7.5.5 5.7.5 12c0 5.1 3.3 9.4 7.9 10.9.6.1.8-.3.8-.6v-2c-3.2.7-3.9-1.5-3.9-1.5-.5-1.3-1.3-1.7-1.3-1.7-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.7-1.6-2.6-.3-5.3-1.3-5.3-5.7 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0C17 4.9 18 5.2 18 5.2c.6 1.6.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.4-2.7 5.4-5.3 5.7.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A11.5 11.5 0 0 0 23.5 12C23.5 5.7 18.3.5 12 .5Z"
            ></path></svg
          >
          {repoName}
        </a>
        <ul class="chips" aria-label="Tools">
          {data.tags.map((t) => <li class="chip">{t}</li>)}
        </ul>
      </div>
    </header>

    <div class="wrap">
      <figure class="media vf">
        {
          data.video ? (
            <video
              src={data.video}
              poster={data.video.replace(".mp4", "-poster.jpg")}
              autoplay
              muted
              loop
              playsinline
              preload="metadata"
              data-autoplay
              width="960"
              height="540"
              aria-label={data.coverAlt}
            />
          ) : (
            <Image
              src={data.cover}
              alt={data.coverAlt}
              widths={[640, 960, 1280, 1600]}
              sizes="(max-width: 1180px) 100vw, 1100px"
              loading="eager"
              fetchpriority="high"
            />
          )
        }
        <figcaption class="mono">{data.coverAlt}</figcaption>
      </figure>

      {
        data.metrics.length > 0 && (
          <dl class="metrics">
            {data.metrics.map((m) => (
              <div>
                <dt class="mono">{m.label}</dt>
                <dd>{m.value}</dd>
              </div>
            ))}
          </dl>
        )
      }
      {
        data.status === "training" && (
          <p class="status">
            <span class="dot" aria-hidden="true" />
            <span>
              <strong>Training now.</strong> Code, data pipeline and tests are done; the full training runs on a
              supercomputer. Results will be added here when the jobs finish.
            </span>
          </p>
        )
      }

      <div class="layout">
        <div class="prose">
          <Content />
        </div>
        <aside class="aside">
          <div class="box">
            <p class="eyebrow">source</p>
            <p><a href={data.repo} rel="noopener" target="_blank">{repoName}</a></p>
            <p class="muted small">Code, README with the papers it builds on, and the scripts that produced every number on this page.</p>
          </div>
          <div class="box">
            <p class="eyebrow">next project</p>
            <p><a href={`/work/${next.id}/`}>{next.data.title} →</a></p>
            <p class="muted small">{next.data.summary}</p>
          </div>
        </aside>
      </div>
    </div>
  </article>

  {
    related.length > 0 && (
      <section class="section">
        <div class="wrap">
          <div class="section-head">
            <div>
              <p class="eyebrow">writing</p>
              <h2>More on this project</h2>
            </div>
          </div>
          <PostList posts={related} />
        </div>
      </section>
    )
  }
</Base>

<script>
  // Safari starts muted inline video only when the properties are set, and refuses autoplay in Low
  // Power Mode: then the first click or tap starts it.
  for (const video of document.querySelectorAll<HTMLVideoElement>("video[data-autoplay]")) {
    video.muted = true;
    video.defaultMuted = true;
    video.playsInline = true;
    const start = () => {
      if (video.paused) video.play().catch(() => {});
    };
    start();
    for (const e of ["pointerdown", "keydown", "touchend"]) window.addEventListener(e, start, { once: true, capture: true });
  }
</script>

<style>
  .head {
    padding-block: clamp(32px, 5vw, 64px) clamp(28px, 4vw, 44px);
  }
  .crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: clamp(28px, 5vw, 56px);
    color: var(--muted);
    font-size: 0.74rem;
  }
  .crumbs a {
    text-decoration: none;
    color: var(--muted);
  }
  .crumbs a:hover {
    color: var(--accent-ink);
  }
  h1 {
    max-width: 18ch;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    align-items: center;
    margin-top: 28px;
  }
  .meta .chips {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .media {
    --c: var(--accent);
    --l: 22px;
    --w: 2px;
    margin: 0;
    padding: 8px;
  }
  .media :global(img),
  .media video {
    width: 100%;
    border-radius: 3px;
    border: 1px solid var(--line);
    background: var(--wash);
  }
  .media video {
    display: block;
    height: auto;
    max-height: 72vh;
    object-fit: contain;
  }
  .media figcaption {
    margin-top: 10px;
    padding-inline: 2px;
    color: var(--muted);
    font-size: 0.72rem;
  }
  .metrics {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    margin: clamp(32px, 5vw, 56px) 0 0;
    border-block: 1px solid var(--line);
  }
  .metrics div {
    display: flex;
    flex-direction: column;
    padding: 22px 20px 22px 0;
  }
  .metrics div + div {
    padding-left: 20px;
    border-left: 1px solid var(--line);
  }
  .metrics dd {
    order: -1;
    margin: 0;
    font-size: clamp(1.8rem, 3.6vw, 2.6rem);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
  }
  .metrics dt {
    color: var(--muted);
    margin-top: 6px;
  }
  .status {
    display: flex;
    gap: 12px;
    align-items: baseline;
    margin: 32px 0 0;
    padding: 16px 18px;
    border: 1px solid var(--accent);
    border-radius: var(--radius);
    background: var(--accent-wash);
    font-size: 0.95rem;
  }
  .status .dot {
    flex: none;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    transform: translateY(-1px);
  }
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 280px;
    gap: clamp(32px, 6vw, 96px);
    padding-block: clamp(40px, 6vw, 72px) clamp(56px, 8vw, 96px);
  }
  .aside {
    display: flex;
    flex-direction: column;
    gap: 16px;
    position: sticky;
    top: calc(var(--header-h) + 24px);
    align-self: start;
  }
  .box {
    padding: 18px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }
  .box p {
    margin: 0 0 6px;
  }
  .box .eyebrow {
    margin-bottom: 10px;
  }
  .small {
    font-size: 0.86rem;
    line-height: 1.5;
  }
  @media (max-width: 900px) {
    .layout {
      grid-template-columns: minmax(0, 1fr);
    }
    .aside {
      position: static;
    }
  }
  @media (max-width: 560px) {
    .metrics div,
    .metrics div + div {
      padding: 16px 0;
      border-left: 0;
    }
    .metrics div + div {
      border-top: 1px solid var(--line);
    }
  }
</style>
