---
import Base from "../layouts/Base.astro";
---

<Base title="Page not found - Kacper Pawlowski" description="This page does not exist." noindex>
  <div class="wrap page">
    <div class="frame vf" aria-hidden="true">
      <span class="tag mono">page 0.00</span>
    </div>
    <p class="eyebrow">404</p>
    <h1>Nothing detected here</h1>
    <p class="lede">
      The detector ran, but no page scored above the threshold. Try the <a href="/">home page</a>, the{" "}
      <a href="/work/">projects</a> or the <a href="/writing/">articles</a>.
    </p>
  </div>
</Base>

<style>
  .page {
    padding-block: clamp(56px, 10vw, 128px);
  }
  .frame {
    --c: var(--accent);
    --l: 22px;
    --w: 2px;
    position: relative;
    width: min(320px, 70%);
    aspect-ratio: 4 / 3;
    margin-bottom: 40px;
    border: 1px dashed var(--line-strong);
  }
  .tag {
    position: absolute;
    top: -22px;
    left: 0;
    padding: 2px 6px;
    background: var(--accent);
    color: var(--ink);
    font-size: 0.7rem;
  }
</style>
