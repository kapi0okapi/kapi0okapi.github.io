---
// The landing-page hero: introduction on the left, the detection/segmentation/depth player on
// the right, and the LiDAR street scan drifting behind both.
import PointField from "./PointField.astro";
import VisionPlayer from "./VisionPlayer.astro";

interface Props {
  lang?: "en" | "nb";
}
const { lang = "en" } = Astro.props;
---

<section class="hero">
  <PointField />
  <div class="wrap hero-grid">
    <div class="intro">
      <slot />
    </div>
    <div class="viewer">
      <VisionPlayer lang={lang} />
    </div>
  </div>
  <p class="wrap scan-note mono" aria-hidden="true">
    <span>bg: KITTI 07 · Velodyne HDL-64E · 90 000 points</span>
  </p>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(40px, 7vw, 96px) 28px;
    isolation: isolate;
  }
  .hero :global(.pointfield) {
    z-index: -1;
    /* fade in below the header and soften the points behind the text column */
    --fade: linear-gradient(180deg, transparent 0, #000 24%);
    --soft: radial-gradient(ellipse 36% 46% at 22% 56%, rgb(0 0 0 / 0.2) 45%, #000 100%);
    -webkit-mask-image: var(--fade), var(--soft);
    -webkit-mask-composite: source-in;
    mask-image: var(--fade), var(--soft);
    mask-composite: intersect;
  }
  @media (max-width: 980px) {
    .hero :global(.pointfield) {
      -webkit-mask-image: var(--fade);
      mask-image: var(--fade);
    }
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(32px, 5vw, 72px);
    align-items: center;
  }
  .viewer {
    background: rgb(255 255 255 / 0.7);
  }
  .scan-note {
    margin: clamp(28px, 4vw, 48px) auto 0;
    display: flex;
    justify-content: flex-end;
    color: var(--muted);
    font-size: 0.68rem;
  }
  .scan-note span {
    background: rgb(255 255 255 / 0.8);
    padding: 2px 6px;
  }

  .intro :global(h1) {
    margin-bottom: 22px;
  }
  .intro :global(.h1-role) {
    display: block;
    margin-top: 14px;
    font-size: clamp(1.15rem, 2vw, 1.5rem);
    font-weight: 500;
    letter-spacing: -0.015em;
    line-height: 1.25;
    color: var(--muted);
  }
  .intro :global(.actions) {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 30px;
  }
  @media (max-width: 980px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
