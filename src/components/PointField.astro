---
// Full-bleed WebGL background: a LiDAR street scan with a sweeping beam (see scripts/pointfield.ts).
interface Props {
  class?: string;
}
const { class: className = "" } = Astro.props;
---

<canvas class:list={["pointfield", className]} data-pointfield aria-hidden="true"></canvas>

<style>
  .pointfield {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0;
    transition: opacity 1.2s ease;
  }
  .pointfield.is-ready {
    opacity: 1;
  }
</style>

<script>
  import { startPointField } from "../scripts/pointfield";

  // decoration only: skipped on phones, where the hero stacks and the cloud would sit off-screen
  const wide = window.matchMedia("(min-width: 721px)").matches;
  for (const canvas of wide ? document.querySelectorAll<HTMLCanvasElement>("[data-pointfield]") : []) {
    const run = () =>
      startPointField(canvas, "/data/street.bin")
        .then(() => canvas.classList.add("is-ready"))
        .catch(() => canvas.remove());
    // the cloud is decoration: load it after the page and the hero video
    if ("requestIdleCallback" in window) requestIdleCallback(run, { timeout: 1500 });
    else setTimeout(run, 400);
  }
</script>
