---
import "@fontsource-variable/geist";
import "@fontsource/geist-mono/400.css";
import "../styles/global.css";
import Seo from "../components/Seo.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { UI, type Lang } from "../lib/i18n";

interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  type?: "website" | "article" | "profile";
  lang?: Lang;
  alternates?: { lang: string; href: string }[];
  noindex?: boolean;
  published?: string;
  modified?: string;
  jsonLd?: object[];
}

const props = Astro.props;
const lang = props.lang ?? "en";
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-48.png" sizes="48x48" type="image/png" />
    <link rel="icon" href="/favicon-96.png" sizes="96x96" type="image/png" />
    <link rel="icon" href="/icon-192.png" sizes="192x192" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title="Kacper Pawlowski - writing" href="/rss.xml" />
    <link rel="me" href="https://github.com/kapi0okapi" />
    <Seo
      title={props.title}
      description={props.description}
      path={Astro.url.pathname}
      image={props.image}
      imageAlt={props.imageAlt}
      type={props.type}
      lang={lang}
      alternates={props.alternates}
      noindex={props.noindex}
      published={props.published}
      modified={props.modified}
      jsonLd={props.jsonLd}
    />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">{UI[lang].skip}</a>
    <Header lang={lang} alternates={props.alternates} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
